{
  "name": "domswp-playground",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "orbit-dev",
      "command": "cd threejs-orbit && npm run dev -- --port 5173 --strictPort"
    },
    {
      "name": "iss-dev",
      "command": "cd iss-tracker && npm run dev -- --port 5174 --strictPort"
    },
    {
      "name": "static-server",
      "command": "python3 -m http.server 8000"
    }
  ],
  "ports": [5173, 5174, 8000]
}
